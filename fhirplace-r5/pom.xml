<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>se.poroli.fhirplace</groupId>
        <artifactId>fhirplace-parent</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>fhirplace-r5-parent</artifactId>
    <packaging>pom</packaging>

    <name>FhirPlace R5 Parent</name>
    <description>Parent for the FHIR R5 model modules.</description>

    <modules>
        <module>core</module>
        <module>resources</module>
        <module>client</module>
        <module>validation</module>
        <module>server</module>
        <module>server-jaxrs</module>
        <module>server-spring</module>
        <module>bom</module>
        <module>all</module>
    </modules>

    <profiles>
        <profile>
            <!-- Test-only modules, never published, so the release build leaves them out. -->
            <id>tests</id>
            <activation>
                <property>
                    <name>!release</name>
                </property>
            </activation>
            <modules>
                <module>serialization-tests</module>
                <module>server-jaxrs-quarkus-tests</module>
            </modules>
        </profile>
        <profile>
            <!-- ./mvnw -Pbenchmarks -pl fhirplace-r5/benchmarks -am verify -DskipTests; see benchmarks/README.md. -->
            <id>benchmarks</id>
            <modules>
                <module>benchmarks</module>
            </modules>
        </profile>
    </profiles>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>se.poroli.fhirplace</groupId>
                <artifactId>fhirplace-r5-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
