<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>se.poroli.fhirplace</groupId>
        <artifactId>fhirplace-r5-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>fhirplace-r5-benchmarks</artifactId>

    <name>FhirPlace R5 Benchmarks</name>
    <description>JMH benchmarks for the R5 modules. Only in the build with -Pbenchmarks; never packaged or published.</description>

    <properties>
        <jmh.version>1.37</jmh.version>
        <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
        <!-- JMH command line options, such as a benchmark regex or "-f 1 -wi 2 -i 3" for a quick run. -->
        <jmh.args></jmh.args>
        <!-- Options for the JMH JVM, which its forks inherit; set per JDK in the profiles below. -->
        <jmh.jvm.args></jmh.jvm.args>
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>se.poroli.fhirplace</groupId>
            <artifactId>fhirplace-r5-core</artifactId>
        </dependency>
        <dependency>
            <groupId>se.poroli.fhirplace</groupId>
            <artifactId>fhirplace-r5-observation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.json</groupId>
            <artifactId>jakarta.json-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.parsson</groupId>
            <artifactId>parsson</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.openjdk.jmh</groupId>
            <artifactId>jmh-core</artifactId>
            <version>${jmh.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.openjdk.jmh</groupId>
                            <artifactId>jmh-generator-annprocess</artifactId>
                            <version>${jmh.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Runs JMH from target/classes in a separate JVM, which forks the measured JVMs; no jar needed. -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>run-benchmarks</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${java.home}/bin/java</executable>
                            <commandlineArgs>${jmh.jvm.args} -classpath %classpath org.openjdk.jmh.Main -rf json -rff ${project.build.directory}/jmh-result.json ${jmh.args}</commandlineArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- JMH 1.37 uses sun.misc.Unsafe, which warns from JDK 24 on; allow it. The option exists from JDK 23. -->
            <id>allow-unsafe</id>
            <activation>
                <jdk>[23,)</jdk>
            </activation>
            <properties>
                <jmh.jvm.args>--sun-misc-unsafe-memory-access=allow</jmh.jvm.args>
            </properties>
        </profile>
    </profiles>
</project>
